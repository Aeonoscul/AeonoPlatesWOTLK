<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- LibStub — must be first -->
	<Script file="Libs\LibStub\LibStub.lua"/>

	<!-- CallbackHandler — required by all Ace3 libs -->
	<Include file="Libs\CallbackHandler-1.0\CallbackHandler-1.0.xml"/>

	<!-- Ace3 core libs (dependency order) -->
	<Include file="Libs\AceAddon-3.0\AceAddon-3.0.xml"/>
	<Include file="Libs\AceEvent-3.0\AceEvent-3.0.xml"/>
	<Include file="Libs\AceHook-3.0\AceHook-3.0.xml"/>
	<Include file="Libs\AceDB-3.0\AceDB-3.0.xml"/>
	<Include file="Libs\AceConsole-3.0\AceConsole-3.0.xml"/>

	<!-- AceConfig chain -->
	<Include file="Libs\AceConfig-3.0\AceConfig-3.0.xml"/>
	<Include file="Libs\AceDBOptions-3.0\AceDBOptions-3.0.xml"/>

	<!-- AceGUI (required by AceConfigDialog) -->
	<Include file="Libs\AceGUI-3.0\AceGUI-3.0.xml"/>

	<!-- SharedMedia for fonts/textures -->
	<Include file="Libs\LibSharedMedia-3.0\lib.xml"/>

	<!-- LDB data broker + minimap icon -->
	<Include file="Libs\LibDBIcon-1.0\lib.xml"/>

	<!-- Compression library -->
	<Include file="Libs\LibDeflate\lib.xml"/>
</Ui>
